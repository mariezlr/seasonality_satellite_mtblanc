# Ignores every file and folder
/* 

# Cancels ignoring all folders
!/**/ 

# ---------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------
# Raw and intermediate data are not versioned (tens of GB). Only a few
# small derived tables are tracked, whitelisted at the bottom of this file.
data/
archive/
output_stable_areas/

# Large formats, wherever they sit
*.nc
*.tif
*.tiff
*.jp2
*.vrt
*.SAFE/
*.parquet
*.gpkg


# ---------------------------------------------------------------------
# Figures
# ---------------------------------------------------------------------
# figures/ and figures_test/ are working directories: exploratory plots,
# variants, drafts. Only figures_paper/ (the 9 manuscript figures) is versioned.
figures/
figures_test/

# ---------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/

# Exploratory and scratch scripts
src/exploratory/
src/test*.py
src/velstudy-nathan/

# ---------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
~$*
*.pptx
*.docx

# ---------------------------------------------------------------------
# Whitelisted data files (small, needed to run the figure scripts)
# ---------------------------------------------------------------------
!data/
!data/output/
!data/output/tau_b_mean_8_glaciers.csv
!data/topography/
!data/topography/mtblanc_glaciers_outlines.csv
src/plots_main.py
src/plots_annex.py
